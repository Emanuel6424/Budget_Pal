  "item": [
    {
      "name": "user",
      "item": [
        {
          "name": "Register User A",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('has id', () => pm.expect(body.id).to.be.a('number'));",
            "pm.collectionVariables.set('userId', body.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\",\n  \"email\": \"ada.{{$randomInt}}@example.com\",\n  \"password\": \"Password123!\"\n}"},
            "url": {"raw": "{{baseUrl}}/user/new", "host": ["{{baseUrl}}"], "path": ["user", "new"]}
          }
        },
        {
          "name": "Register User B (for ownership-denied tests)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 201', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('otherUserId', body.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Babbage\",\n  \"email\": \"bob.{{$randomInt}}@example.com\",\n  \"password\": \"Password123!\"\n}"},
            "url": {"raw": "{{baseUrl}}/user/new", "host": ["{{baseUrl}}"], "path": ["user", "new"]}
          }
        }
      ]
