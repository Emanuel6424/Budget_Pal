{
  "info": {
    "_postman_id": "b6c1f2a0-1f0a-4b6a-9b2e-budgetpal0001",
    "name": "BudgetPal",
    "description": "BudgetPal API. No JWT auth exists yet (MVP) - userId/accountId/etc. are client-supplied in request bodies/params, not token-derived. Run requests top-to-bottom within a folder; later requests rely on collection variables saved by earlier ones.",
