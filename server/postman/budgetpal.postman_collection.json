          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"accountId\": {{accountId}},\n  \"date\": \"2026-11-01\",\n  \"description\": \"Groceries\",\n  \"merchant\": \"Trader Joes\",\n  \"amount\": 50.00,\n  \"type\": \"EXPENSE\",\n  \"categoryId\": {{categoryId}}\n}"},
            "url": {"raw": "{{baseUrl}}/transaction/new", "host": ["{{baseUrl}}"], "path": ["transaction", "new"]}
          }
        },
        {
          "name": "Get Account Balance (sanity check before edit)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('balance reflects the 50.00 expense', () => pm.expect(body.balance).to.eql(450.0));",
            "pm.collectionVariables.set('balanceBeforeEdit', body.balance);"
          ]}}],
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/account/get/account/{{accountId}}", "host": ["{{baseUrl}}"], "path": ["account", "get", "account", "{{accountId}}"]}
          }
        },
        {
          "name": "Update Transaction - success, amount change does NOT touch balance",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('amount updated', () => pm.expect(body.amount).to.eql(999.00));",
            "pm.test('description updated', () => pm.expect(body.description).to.eql('Groceries (corrected)'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"description\": \"Groceries (corrected)\",\n  \"amount\": 999.00\n}"},
