  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "categoryId", "value": "1" },
    { "key": "userId", "value": "" },
    { "key": "otherUserId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "otherAccountId", "value": "" },
