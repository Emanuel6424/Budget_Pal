          "name": "Delete Transaction - not found -> 400",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 400', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/transaction/999999?userId={{userId}}", "host": ["{{baseUrl}}"], "path": ["transaction", "999999"], "query": [{"key": "userId", "value": "{{userId}}"}]}
          }
        },
        {
          "name": "Delete Transaction - success, reverses the balance effect",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 204', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "url": {"raw": "{{baseUrl}}/transaction/{{transactionId}}?userId={{userId}}", "host": ["{{baseUrl}}"], "path": ["transaction", "{{transactionId}}"], "query": [{"key": "userId", "value": "{{userId}}"}]}
          }
        },
        {
          "name": "Get Account Balance (confirm delete added the 999.00 expense back)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": [
            "pm.test('status is 200', () => pm.response.to.have.status(200));",
